{
  "name": "es-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Event-sourcing + CQRS backend (event store, snapshots, projection, optimistic concurrency)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "stress": "tsx scripts/stress-repro.ts",
    "stress:replay": "tsx scripts/stress-replay-during-writes.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "fastify": "^5.2.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
